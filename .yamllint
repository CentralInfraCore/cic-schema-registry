---
# .yamllint configuration
# See https://yamllint.readthedocs.io/en/stable/configuration.html

extends: default

rules:
  # Increase the line-length limit to a more reasonable value for modern displays.
  line-length:
    max: 140
    level: warning  # Set to 'warning' instead of 'error' to be less strict.

  # GitHub Actions uses 'on' as a valid key, which is a truthy value.
  truthy:
    allowed-values: ['true', 'false', 'on']

# Override rules for specific file paths
file-rules:
  .github/workflows/*.yml:
    document-start:
      present: false  # GitHub Actions workflows don't require the document start marker.

ignore: |
  /p_venv/
  # Machine-generated release bundles migrated byte-verbatim from their
  # source repo's own `make release` output (proposals/schema-registry:
  # the primitive kernel is versioned/signed as one indivisible artifact,
  # never hand-edited here — see general/primitives/cic-primitives/README.md).
  # Reformatting them to satisfy this repo's own style rules would break
  # their byte-identity with the real, already-signed release.
  /general/primitives/cic-primitives/
